# ─── Aztec ───
AZTEC_RPC_URL=http://localhost:8080
AZTEC_CHAIN_ID=31337

# ─── Admin (Phase 1: single EOA, multi-sig prep) ───
ADMIN_PRIVATE_KEY=
WHITELISTED_CREATORS=

# ─── Indexer / PostgreSQL ───
DATABASE_URL=postgresql://honkers:honkers@localhost:5432/honkers
INDEXER_PORT=3001

# ─── Keeper ───
KEEPER_POLL_INTERVAL_MS=300000
KEEPER_AUTO_VOID_MODE=alert_only
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# ─── Indexer (optional auth for metadata POST) ───
INDEXER_METADATA_SECRET=

# ─── Deployed contracts (required for indexer poller + frontend) ───
MARKET_FACTORY_ADDRESS=
AMM_ADDRESS=
ORACLE_ADDRESS=
TEST_TOKEN_ADDRESS=

# ─── Frontend ───
VITE_AZTEC_RPC_URL=http://localhost:8080
VITE_INDEXER_API_URL=http://localhost:3001
# Comma-separated Aztec addresses allowed to access /admin
VITE_ADMIN_ADDRESSES=

# ─── Sentry (no PII in logs) ───
VITE_SENTRY_DSN=

# ─── Geo-blocking (Vercel edge) ───
BLOCKED_JURISDICTIONS=US,CN,GB
