# Honkers production — static dist + JSON-RPC proxy (replaces Vite dev on EC2).
# Placeholders __RPC_ORIGIN__ and __RPC_HOST__ are replaced at container start.

server {
    listen 5173;
    listen [::]:5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm;

    # Match Vite dev proxy: /rpc → /, /rpc/foo → /foo (Aztec JSON-RPC)
    location = /rpc {
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host __RPC_HOST__;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_pass __RPC_ORIGIN__/;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location /rpc/ {
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host __RPC_HOST__;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_pass __RPC_ORIGIN__/;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }
}
