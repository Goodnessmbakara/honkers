# Honkers production — static dist + JSON-RPC proxy.
# Placeholders __RPC_ORIGIN__ and __RPC_HOST__ are replaced at container start.
# NOTE: nginx serves HTTP/1.1 to the ALB which handles HTTP/2 for the browser.

server {
    listen 5173;
    listen [::]:5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Tune for large JS chunks (aztec-sdk is ~25MB gzipped)
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 120s;
    send_timeout 300s;

    # Output buffers large enough for big JS chunks
    output_buffers 8 1m;
    postpone_output 0;

    # Gzip compression
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_buffers 32 8k;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/wasm
        font/woff2;

    # Cache content-hashed static assets forever
    location ~* \.(js|css|wasm|woff2|png|svg|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }

    # /rpc → Aztec testnet JSON-RPC proxy
    location = /rpc {
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host __RPC_HOST__;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_pass __RPC_ORIGIN__/;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location /rpc/ {
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host __RPC_HOST__;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_pass __RPC_ORIGIN__/;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }
}
